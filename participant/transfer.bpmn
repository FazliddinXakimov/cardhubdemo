<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="CardLabDefinitions" targetNamespace="urn:cardlab:training" exporter="CardLab" exporterVersion="1.0">
  <bpmn:process id="TransferProcess" name="CardLab - pul o'tkazish" isExecutable="false">
    <bpmn:documentation>O'quv jarayoni. Kiritma to'g'ri: summa R1ga mos, ikkala ID mavjud va turlicha. Komissiya 1%, yuqoriga yaxlitlanadi. Barcha rad etishlarda holat o'zgarmaydi.</bpmn:documentation>
    <bpmn:startEvent id="Start" name="Boshlash">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Input" name="Yuboruvchi, oluvchi va&#10;summani kiritish">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Valid" name="Summa va IDlar&#10;to'g'rimi? [R1]" gatewayDirection="Diverging" default="F4">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Active" name="Ikkala karta&#10;faolmi? [R2]" gatewayDirection="Diverging" default="F6">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Fee" name="Komissiya va jami&#10;yechimni hisoblash">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Funds" name="Balans jami&#10;yechimga yetadimi?" gatewayDirection="Diverging" default="F9">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Update" name="Ikkala balansni&#10;yangilash">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Save" name="Bitta tarix yozuvi&#10;yaratish va saqlash">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Success" name="Bajarildi">
      <bpmn:incoming>F11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="RejectMerge" gatewayDirection="Converging">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Reject" name="Sababni ko'rsatish&#10;Holat o'zgarmaydi&#10;[R3]">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Rejected" name="Rad etildi">
      <bpmn:incoming>F13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Input" />
    <bpmn:sequenceFlow id="F2" sourceRef="Input" targetRef="Valid" />
    <bpmn:sequenceFlow id="F3" sourceRef="Valid" targetRef="Active" name="Ha">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">valid_input</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F4" sourceRef="Valid" targetRef="RejectMerge" name="Yo'q" />
    <bpmn:sequenceFlow id="F5" sourceRef="Active" targetRef="Fee" name="Ha">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">cards_active</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F6" sourceRef="Active" targetRef="RejectMerge" name="Yo'q" />
    <bpmn:sequenceFlow id="F7" sourceRef="Fee" targetRef="Funds" />
    <bpmn:sequenceFlow id="F8" sourceRef="Funds" targetRef="Update" name="Ha">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">balance_sufficient</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F9" sourceRef="Funds" targetRef="RejectMerge" name="Yo'q" />
    <bpmn:sequenceFlow id="F10" sourceRef="Update" targetRef="Save" />
    <bpmn:sequenceFlow id="F11" sourceRef="Save" targetRef="Success" />
    <bpmn:sequenceFlow id="F12" sourceRef="RejectMerge" targetRef="Reject" />
    <bpmn:sequenceFlow id="F13" sourceRef="Reject" targetRef="Rejected" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="TransferProcess">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="212" y="20" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="270" y="24" width="160" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Input_di" bpmnElement="Input">
        <dc:Bounds x="80" y="90" width="300" height="72" />
