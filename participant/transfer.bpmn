      <bpmndi:BPMNShape id="Success_di" bpmnElement="Success">
        <dc:Bounds x="212" y="1012" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="270" y="1016" width="170" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="RejectMerge_di" bpmnElement="RejectMerge" isMarkerVisible="true">
        <dc:Bounds x="654" y="622" width="72" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Reject_di" bpmnElement="Reject">
        <dc:Bounds x="540" y="756" width="300" height="96" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Rejected_di" bpmnElement="Rejected">
        <dc:Bounds x="672" y="918" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="730" y="922" width="160" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1">
        <di:waypoint x="230" y="56" />
        <di:waypoint x="230" y="90" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2">
        <di:waypoint x="230" y="162" />
        <di:waypoint x="230" y="214" />
      </bpmndi:BPMNEdge>
